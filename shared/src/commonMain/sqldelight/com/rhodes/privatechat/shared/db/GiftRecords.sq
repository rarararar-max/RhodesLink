CREATE TABLE IF NOT EXISTS gift_records (
    id INTEGER NOT NULL PRIMARY KEY,
    operatorId TEXT NOT NULL,
    imageUri TEXT NOT NULL,
    giftName TEXT NOT NULL,
    senderName TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

getByOperator:
SELECT * FROM gift_records WHERE operatorId = ? ORDER BY createdAt DESC, id DESC;

getAllGifts:
SELECT * FROM gift_records ORDER BY createdAt DESC, id DESC;

insert:
INSERT INTO gift_records(id, operatorId, imageUri, giftName, senderName, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

delete:
DELETE FROM gift_records WHERE id = ?;

deleteByOperator:
DELETE FROM gift_records WHERE operatorId = ?;

deleteAllGifts:
DELETE FROM gift_records;
