CREATE TABLE IF NOT EXISTS diaries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    operatorId TEXT NOT NULL,
    operatorName TEXT NOT NULL,
    content TEXT NOT NULL,
    date TEXT NOT NULL,
    createdAt INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_diaries_operator_date
ON diaries(operatorId, date);

getDiariesByOperator:
SELECT * FROM diaries WHERE operatorId = ? ORDER BY date DESC;

getDiary:
SELECT * FROM diaries WHERE operatorId = ? AND date = ? ORDER BY id DESC LIMIT 1;

getAllDiaryEntries:
SELECT * FROM diaries WHERE operatorId = ? ORDER BY id DESC;

getDiaryDates:
SELECT DISTINCT date FROM diaries WHERE operatorId = ? ORDER BY date DESC;

getCount:
SELECT COUNT(*) FROM diaries;

insertDiary:
INSERT OR REPLACE INTO diaries(operatorId, operatorName, content, date, createdAt)
VALUES (?, ?, ?, ?, ?);

deleteOldDiaries:
DELETE FROM diaries WHERE createdAt < ?;
