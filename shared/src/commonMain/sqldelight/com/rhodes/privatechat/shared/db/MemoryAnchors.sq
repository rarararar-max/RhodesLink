CREATE TABLE IF NOT EXISTS memory_anchors (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    operatorId TEXT NOT NULL,
    type TEXT NOT NULL,
    content TEXT NOT NULL,
    isPrivate INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL DEFAULT 0,
    expiresAt INTEGER NOT NULL DEFAULT 0,
    source TEXT NOT NULL DEFAULT '',
    sourceName TEXT NOT NULL DEFAULT '',
    sourceActor TEXT NOT NULL DEFAULT '',
    sourceTarget TEXT NOT NULL DEFAULT '',
    importance TEXT NOT NULL DEFAULT '',
    knownFrom TEXT NOT NULL DEFAULT ''
);

getPublicAnchors:
SELECT * FROM memory_anchors WHERE operatorId = ? AND isPrivate = 0 AND expiresAt > ? ORDER BY createdAt DESC;

getAllAnchors:
SELECT * FROM memory_anchors WHERE operatorId = ? AND expiresAt > ? ORDER BY createdAt DESC;

getDuplicateCandidates:
SELECT * FROM memory_anchors WHERE operatorId = ? AND type = ? AND isPrivate = ? AND source = ? AND sourceName = ? AND expiresAt > ? ORDER BY createdAt DESC;

getAnchorCount:
SELECT COUNT(*) FROM memory_anchors;

getAllAnchorsForBackup:
SELECT * FROM memory_anchors ORDER BY createdAt DESC;

insertAnchor:
INSERT OR REPLACE INTO memory_anchors(sessionId, operatorId, type, content, isPrivate, createdAt, expiresAt, source, sourceName, sourceActor, sourceTarget, importance, knownFrom)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteExpiredAnchors:
DELETE FROM memory_anchors WHERE expiresAt < ?;

-- Old builds defaulted anchor retention to 7 days, so every anchor written back then carries an expiry
-- that has already lapsed. Changing the retention setting cannot revive those rows: every recall query
-- filters on expiresAt > now, and the cleanup sweep physically deletes them. The next two statements are
-- the one-time repair, run only while the user's anchor retention is the permanent sentinel.
restorePermanentAnchorExpiry:
UPDATE memory_anchors SET expiresAt = :newExpiry WHERE type != 'EMOTION' AND expiresAt < :now;

-- Emotion anchors keep the product's own 7-day rule, so survivors are only pushed 7 days forward.
restoreEmotionAnchorExpiry:
UPDATE memory_anchors SET expiresAt = :newExpiry WHERE type = 'EMOTION' AND expiresAt < :now;


deleteOldAnchors:
DELETE FROM memory_anchors WHERE createdAt < ?;

deleteAnchorsBySession:
DELETE FROM memory_anchors WHERE sessionId = ?;

deleteAnchorsByOperator:
DELETE FROM memory_anchors WHERE operatorId = ?;

deleteAllAnchors:
DELETE FROM memory_anchors;

enforceAnchorRetain:
DELETE FROM memory_anchors WHERE operatorId = ? AND id NOT IN (
    SELECT id FROM memory_anchors WHERE operatorId = ? ORDER BY createdAt DESC LIMIT ?
);

retainArchiveTimelineAnchors:
UPDATE memory_anchors SET sessionId = :historyId WHERE sessionId = :sessionId;
