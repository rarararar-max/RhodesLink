CREATE TABLE IF NOT EXISTS vector_memories (
    id TEXT NOT NULL PRIMARY KEY,
    ownerType TEXT NOT NULL,
    ownerId TEXT NOT NULL,
    sourceType TEXT NOT NULL,
    sourceId TEXT NOT NULL,
    content TEXT NOT NULL,
    importance REAL NOT NULL DEFAULT 0,
    embeddingJson TEXT NOT NULL DEFAULT '[]',
    tags TEXT NOT NULL DEFAULT '',
    visibility TEXT NOT NULL DEFAULT 'public',
    embeddingSignature TEXT NOT NULL DEFAULT '',
    createdAt INTEGER NOT NULL DEFAULT 0,
    expiresAt INTEGER NOT NULL DEFAULT 9223372036854775807
);

CREATE INDEX IF NOT EXISTS vector_memories_owner_candidates
ON vector_memories(ownerType, ownerId, expiresAt, importance DESC, createdAt DESC);

getVectorMemoriesByOwner:
SELECT * FROM vector_memories WHERE ownerType = ? AND ownerId = ? ORDER BY createdAt DESC;

getVectorCandidatesByOwner:
SELECT * FROM vector_memories
WHERE ownerType = ?
  AND ownerId = ?
  AND expiresAt > ?
  AND createdAt >= ?
  AND importance >= ?
  AND embeddingSignature = ?
ORDER BY
  CASE sourceType
    WHEN 'memory_v2_l3' THEN 3
    WHEN 'memory_v2_l2' THEN 2
    ELSE 1
  END DESC,
  importance DESC,
  createdAt DESC
LIMIT ?;

getVectorCandidatesByOwnerAndSourceKind:
SELECT * FROM vector_memories
WHERE ownerType = ?
  AND ownerId = ?
  AND (tags = ? OR tags LIKE '%,' || ?)
  AND expiresAt > ?
  AND createdAt >= ?
  AND importance >= ?
  AND embeddingSignature = ?
ORDER BY
  CASE sourceType
    WHEN 'memory_v2_l3' THEN 3
    WHEN 'memory_v2_l2' THEN 2
    ELSE 1
  END DESC,
  importance DESC,
  createdAt DESC
LIMIT ?;

getVectorCandidatesByOwnerAndSourceType:
SELECT * FROM vector_memories
WHERE ownerType = ?
  AND ownerId = ?
  AND sourceType = ?
  AND expiresAt > ?
  AND createdAt >= ?
  AND createdAt < ?
  AND importance >= ?
  AND embeddingSignature = ?
ORDER BY
  CASE WHEN ? = 1 THEN createdAt ELSE importance END DESC,
  CASE WHEN ? = 1 THEN importance ELSE createdAt END DESC
LIMIT ?;

getVectorCandidatesByOwnerAndSourceTypeAndSourceKind:
SELECT * FROM vector_memories
WHERE ownerType = ?
  AND ownerId = ?
  AND sourceType = ?
  AND (tags = ? OR tags LIKE '%,' || ?)
  AND expiresAt > ?
  AND createdAt >= ?
  AND createdAt < ?
  AND importance >= ?
  AND embeddingSignature = ?
ORDER BY
  CASE WHEN ? = 1 THEN createdAt ELSE importance END DESC,
  CASE WHEN ? = 1 THEN importance ELSE createdAt END DESC
LIMIT ?;

insertVectorMemory:
INSERT OR REPLACE INTO vector_memories(id, ownerType, ownerId, sourceType, sourceId, content, importance, embeddingJson, tags, visibility, embeddingSignature, createdAt, expiresAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteVectorMemory:
DELETE FROM vector_memories WHERE id = ?;

deleteExpiredVectorMemories:
DELETE FROM vector_memories WHERE expiresAt < ?;

deleteVectorMemoriesByOwner:
DELETE FROM vector_memories WHERE ownerType = ? AND ownerId = ?;

deleteVectorMemoriesBySource:
DELETE FROM vector_memories WHERE ownerType = ? AND ownerId = ? AND sourceId = ?;

deleteVectorMemoriesBySourceId:
DELETE FROM vector_memories WHERE sourceId = ?;

deleteVectorMemoriesBySourceTypeAndId:
DELETE FROM vector_memories WHERE sourceType = ? AND sourceId = ?;

deleteVectorsForMemorySource:
DELETE FROM vector_memories
WHERE id IN (
    SELECT vectorId FROM memory_items
    WHERE sourceKind = ? AND sourceRefId = ? AND vectorId != ''
);

deleteVectorsForMemorySession:
DELETE FROM vector_memories
WHERE id IN (
    SELECT vectorId FROM memory_items
    WHERE sessionId = ? AND vectorId != ''
);

deleteAllVectorMemories:
DELETE FROM vector_memories;
