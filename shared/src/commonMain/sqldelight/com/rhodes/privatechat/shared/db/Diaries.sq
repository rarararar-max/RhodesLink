CREATE TABLE IF NOT EXISTS diaries (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    operatorId TEXT NOT NULL,
    operatorName TEXT NOT NULL,
    content TEXT NOT NULL,
    date TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL DEFAULT 0
);

getDiariesByOperator:
SELECT * FROM diaries WHERE operatorId = ? ORDER BY date DESC, version DESC, createdAt DESC, id DESC;

getDiary:
SELECT * FROM diaries WHERE operatorId = ? AND date = ? ORDER BY version DESC, createdAt DESC, id DESC LIMIT 1;

getAllDiaryEntries:
SELECT * FROM diaries WHERE operatorId = ? ORDER BY date DESC, version DESC, createdAt DESC, id DESC;

getDiaryDates:
SELECT DISTINCT date FROM diaries WHERE operatorId = ? ORDER BY date DESC;

getCount:
SELECT COUNT(*) FROM diaries;

getAllDiariesForBackup:
SELECT * FROM diaries ORDER BY date DESC, id DESC;

getNextVersion:
SELECT COALESCE(MAX(version), 0) + 1 FROM diaries WHERE operatorId = ? AND date = ?;

insertDiary:
INSERT INTO diaries(operatorId, operatorName, content, date, version, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

deleteOldDiaries:
DELETE FROM diaries WHERE createdAt < ?;
