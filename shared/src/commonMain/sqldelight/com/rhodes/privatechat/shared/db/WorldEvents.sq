CREATE TABLE IF NOT EXISTS world_events (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    type TEXT NOT NULL,
    actorId TEXT NOT NULL DEFAULT '',
    actorName TEXT NOT NULL DEFAULT '',
    targetId TEXT NOT NULL DEFAULT '',
    targetName TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL DEFAULT '',
    sourceId TEXT NOT NULL DEFAULT '',
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL DEFAULT 0,
    expiresAt INTEGER NOT NULL DEFAULT 9223372036854775807,
    consumedBy TEXT NOT NULL DEFAULT '',
    originType TEXT NOT NULL DEFAULT '',
    chainDepth INTEGER NOT NULL DEFAULT 0,
    rootEventId INTEGER NOT NULL DEFAULT 0
);

getRecentWorldEvents:
SELECT * FROM world_events WHERE expiresAt > ? ORDER BY createdAt DESC LIMIT ?;

getWorldEventsByType:
SELECT * FROM world_events WHERE type = ? AND expiresAt > ? ORDER BY createdAt DESC LIMIT ?;

getWorldEventsForOperator:
SELECT * FROM world_events WHERE expiresAt > ? AND (actorId = ? OR targetId = ? OR content LIKE ?) ORDER BY createdAt DESC LIMIT ?;

getUnconsumedWorldEventsForOperator:
SELECT * FROM world_events
WHERE expiresAt > ?
AND consumedBy NOT LIKE ?
AND (actorId = ? OR targetId = ? OR content LIKE ?)
ORDER BY createdAt DESC LIMIT ?;

getUnconsumedWorldEventsForGroup:
SELECT * FROM world_events
WHERE expiresAt > ?
AND consumedBy NOT LIKE ?
AND (content LIKE ? OR actorId LIKE ? OR targetId LIKE ? OR actorName LIKE ? OR targetName LIKE ?)
ORDER BY createdAt DESC LIMIT ?;

getUnconsumedWorldEventsByType:
SELECT * FROM world_events
WHERE type = ?
AND expiresAt > ?
AND consumedBy NOT LIKE ?
ORDER BY createdAt DESC LIMIT ?;

countWorldEventsByTypeSince:
SELECT COUNT(*) FROM world_events WHERE type = ? AND createdAt >= ?;

countChainedWorldEventsByTypeSince:
SELECT COUNT(*) FROM world_events WHERE type = ? AND createdAt >= ? AND chainDepth > 0;

getWorldEventCount:
SELECT COUNT(*) FROM world_events;

getAllWorldEventsForBackup:
SELECT * FROM world_events ORDER BY createdAt DESC;

getWorldEvent:
SELECT * FROM world_events WHERE id = ?;

insertWorldEvent:
INSERT OR REPLACE INTO world_events(type, actorId, actorName, targetId, targetName, source, sourceId, content, createdAt, expiresAt, consumedBy, originType, chainDepth, rootEventId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getLastInsertRowId:
SELECT last_insert_rowid();

markWorldEventConsumed:
UPDATE world_events SET consumedBy = ? WHERE id = ?;

deleteExpiredWorldEvents:
DELETE FROM world_events WHERE expiresAt < ?;

deleteAllWorldEvents:
DELETE FROM world_events;
