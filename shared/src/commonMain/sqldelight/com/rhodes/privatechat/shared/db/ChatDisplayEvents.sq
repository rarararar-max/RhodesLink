CREATE TABLE IF NOT EXISTS chat_display_events (
    messageId INTEGER NOT NULL,
    segmentIndex INTEGER NOT NULL DEFAULT -1,
    sessionId TEXT NOT NULL,
    revealOrder INTEGER NOT NULL,
    PRIMARY KEY (messageId, segmentIndex)
);

CREATE INDEX IF NOT EXISTS idx_chat_display_events_session_order
ON chat_display_events(sessionId, revealOrder);

getDisplayEvents:
SELECT messageId, segmentIndex, revealOrder
FROM chat_display_events
WHERE sessionId = ?
ORDER BY revealOrder ASC, messageId ASC, segmentIndex ASC;

getAllDisplayEvents:
SELECT messageId, segmentIndex, sessionId, revealOrder
FROM chat_display_events
ORDER BY sessionId ASC, revealOrder ASC, messageId ASC, segmentIndex ASC;

getNextRevealOrder:
SELECT MAX(revealOrder) FROM chat_display_events WHERE sessionId = ?;

getDisplayEventOrder:
SELECT revealOrder FROM chat_display_events WHERE messageId = ? AND segmentIndex = ?;

insertDisplayEventIfAbsent:
INSERT OR IGNORE INTO chat_display_events(messageId, segmentIndex, sessionId, revealOrder)
VALUES (?, ?, ?, ?);

deleteDisplayEvent:
DELETE FROM chat_display_events WHERE messageId = ? AND segmentIndex = ?;

deleteMessageDisplayEvents:
DELETE FROM chat_display_events WHERE messageId = ?;

deleteSessionDisplayEvents:
DELETE FROM chat_display_events WHERE sessionId = ?;

moveSessionDisplayEvents:
UPDATE chat_display_events SET sessionId = ? WHERE sessionId = ?;

deleteAllDisplayEvents:
DELETE FROM chat_display_events;

deleteOldDisplayEvents:
DELETE FROM chat_display_events WHERE messageId IN (
    SELECT id FROM chat_messages WHERE timestamp < ?
);
