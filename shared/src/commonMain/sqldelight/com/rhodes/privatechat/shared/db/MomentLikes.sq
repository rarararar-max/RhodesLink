CREATE TABLE IF NOT EXISTS moment_likes (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    momentId INTEGER NOT NULL,
    operatorId TEXT NOT NULL,
    operatorName TEXT NOT NULL,
    createdAt INTEGER NOT NULL DEFAULT 0
);

getLikes:
SELECT * FROM moment_likes WHERE momentId = ?;

getAllLikesForBackup:
SELECT * FROM moment_likes ORDER BY createdAt DESC;

getLikesFlow:
SELECT * FROM moment_likes WHERE momentId = ?;

insertLike:
INSERT OR REPLACE INTO moment_likes(momentId, operatorId, operatorName, createdAt)
VALUES (?, ?, ?, ?);

deleteLike:
DELETE FROM moment_likes WHERE momentId = ? AND operatorId = ?;

getLikeCount:
SELECT COUNT(*) FROM moment_likes WHERE momentId = ?;

getLike:
SELECT * FROM moment_likes WHERE momentId = ? AND operatorId = ? LIMIT 1;
