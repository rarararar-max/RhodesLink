CREATE TABLE IF NOT EXISTS vector_memories (
    id TEXT NOT NULL PRIMARY KEY,
    ownerType TEXT NOT NULL,
    ownerId TEXT NOT NULL,
    sourceType TEXT NOT NULL,
    sourceId TEXT NOT NULL,
    content TEXT NOT NULL,
    importance REAL NOT NULL DEFAULT 0,
    embeddingJson TEXT NOT NULL DEFAULT '[]',
    tags TEXT NOT NULL DEFAULT '',
    visibility TEXT NOT NULL DEFAULT 'public',
    createdAt INTEGER NOT NULL DEFAULT 0,
    expiresAt INTEGER NOT NULL DEFAULT 9223372036854775807
);

getVectorMemoriesByOwner:
SELECT * FROM vector_memories WHERE ownerType = ? AND ownerId = ? ORDER BY createdAt DESC;

insertVectorMemory:
INSERT OR REPLACE INTO vector_memories(id, ownerType, ownerId, sourceType, sourceId, content, importance, embeddingJson, tags, visibility, createdAt, expiresAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteVectorMemory:
DELETE FROM vector_memories WHERE id = ?;

deleteExpiredVectorMemories:
DELETE FROM vector_memories WHERE expiresAt < ?;

deleteVectorMemoriesByOwner:
DELETE FROM vector_memories WHERE ownerType = ? AND ownerId = ?;

deleteVectorMemoriesBySource:
DELETE FROM vector_memories WHERE ownerType = ? AND ownerId = ? AND sourceId = ?;

deleteVectorMemoriesBySourceId:
DELETE FROM vector_memories WHERE sourceId = ?;

deleteVectorMemoriesBySourceTypeAndId:
DELETE FROM vector_memories WHERE sourceType = ? AND sourceId = ?;

deleteVectorsForMemorySource:
DELETE FROM vector_memories
WHERE id IN (
    SELECT vectorId FROM memory_items
    WHERE sourceKind = ? AND sourceRefId = ? AND vectorId != ''
);

deleteAllVectorMemories:
DELETE FROM vector_memories;
