CREATE TABLE IF NOT EXISTS chat_archives (
    id TEXT NOT NULL PRIMARY KEY,
    sessionId TEXT NOT NULL,
    operatorId TEXT NOT NULL,
    title TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    mode TEXT NOT NULL DEFAULT 'online',
    messagesJson TEXT NOT NULL,
    summary TEXT NOT NULL DEFAULT '',
    stateJson TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'pending',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_chat_archives_session_created ON chat_archives(sessionId, createdAt DESC);

CREATE TABLE IF NOT EXISTS chat_history_segments (
    id TEXT NOT NULL PRIMARY KEY,
    sessionId TEXT NOT NULL,
    title TEXT NOT NULL,
    reason TEXT NOT NULL,
    messagesJson TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_chat_history_segments_session_created ON chat_history_segments(sessionId, createdAt DESC);

getArchivesBySession:
SELECT * FROM chat_archives WHERE sessionId = ? ORDER BY createdAt DESC;

getArchive:
SELECT * FROM chat_archives WHERE id = ?;

getPendingArchives:
SELECT * FROM chat_archives WHERE status = 'pending' ORDER BY updatedAt ASC;

insertArchive:
INSERT OR REPLACE INTO chat_archives(id, sessionId, operatorId, title, note, mode, messagesJson, summary, stateJson, status, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateArchiveSummary:
UPDATE chat_archives SET summary = ?, status = ?, updatedAt = ? WHERE id = ?;

updateArchiveTitle:
UPDATE chat_archives SET title = ?, updatedAt = ? WHERE id = ?;

updateArchiveContext:
UPDATE chat_archives SET stateJson = ?, updatedAt = ? WHERE id = ?;

deleteArchive:
DELETE FROM chat_archives WHERE id = ?;

deleteArchivesBySession:
DELETE FROM chat_archives WHERE sessionId = ?;

getHistorySegmentsBySession:
SELECT * FROM chat_history_segments WHERE sessionId = ? ORDER BY createdAt DESC;

insertHistorySegment:
INSERT OR REPLACE INTO chat_history_segments(id, sessionId, title, reason, messagesJson, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

deleteHistorySegmentsBySession:
DELETE FROM chat_history_segments WHERE sessionId = ?;
