CREATE TABLE IF NOT EXISTS mahjong_saves (
    id TEXT NOT NULL PRIMARY KEY DEFAULT 'current',
    saveJson TEXT NOT NULL,
    ruleType TEXT NOT NULL DEFAULT '',
    savedAt INTEGER NOT NULL DEFAULT 0
);

getSave:
SELECT * FROM mahjong_saves WHERE id = 'current';

insertSave:
INSERT OR REPLACE INTO mahjong_saves(id, saveJson, ruleType, savedAt)
VALUES (?, ?, ?, ?);

deleteSave:
DELETE FROM mahjong_saves WHERE id = 'current';
