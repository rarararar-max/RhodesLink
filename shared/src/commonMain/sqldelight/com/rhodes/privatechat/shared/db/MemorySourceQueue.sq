CREATE TABLE IF NOT EXISTS memory_source_queue (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sourceKind TEXT NOT NULL,
    ownerType TEXT NOT NULL,
    ownerId TEXT NOT NULL,
    sourceRefId TEXT NOT NULL,
    contentText TEXT NOT NULL,
    timestamp INTEGER NOT NULL DEFAULT 0,
    processedL1 INTEGER NOT NULL DEFAULT 0,
    processedVector INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL DEFAULT 0
);

getPendingMemorySources:
SELECT * FROM memory_source_queue WHERE processedL1 = 0 ORDER BY timestamp ASC, id ASC;

insertMemorySource:
INSERT OR REPLACE INTO memory_source_queue(sourceKind, ownerType, ownerId, sourceRefId, contentText, timestamp, processedL1, processedVector, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getLastInsertedMemorySourceId:
SELECT last_insert_rowid();

markMemorySourceProcessedL1:
UPDATE memory_source_queue SET processedL1 = 1 WHERE id = ?;

markMemorySourceProcessedVector:
UPDATE memory_source_queue SET processedVector = 1 WHERE id = ?;

deleteMemorySourcesByOwner:
DELETE FROM memory_source_queue WHERE ownerType = ? AND ownerId = ?;

deleteMemorySourcesByOwnerAndKind:
DELETE FROM memory_source_queue WHERE ownerType = ? AND ownerId = ? AND sourceKind = ?;

deletePrivateRelationshipSources:
DELETE FROM memory_source_queue WHERE ownerType = ? AND ownerId = ? AND sourceKind = 'PRIVATE_CHAT';

deleteMemorySourcesBySession:
DELETE FROM memory_source_queue WHERE sourceRefId = ?;

deleteMemorySourcesBySource:
DELETE FROM memory_source_queue WHERE sourceKind = ? AND sourceRefId = ?;

deleteMemorySourcesBySourcePrefix:
DELETE FROM memory_source_queue WHERE sourceKind = ? AND sourceRefId LIKE ?;

deleteMemorySource:
DELETE FROM memory_source_queue WHERE id = ?;

deleteProcessedMemorySourcesBefore:
DELETE FROM memory_source_queue WHERE processedL1 = 1 AND createdAt < ?;
