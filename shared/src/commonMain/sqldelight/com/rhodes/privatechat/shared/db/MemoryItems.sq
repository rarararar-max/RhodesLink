CREATE TABLE IF NOT EXISTS memory_items (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ownerType TEXT NOT NULL,
    ownerId TEXT NOT NULL,
    memoryLevel TEXT NOT NULL,
    memoryType TEXT NOT NULL,
    sourceKind TEXT NOT NULL,
    sourceRefId TEXT NOT NULL DEFAULT '',
    sessionId TEXT NOT NULL DEFAULT '',
    content TEXT NOT NULL,
    nickname TEXT NOT NULL DEFAULT '',
    importance INTEGER NOT NULL DEFAULT 0,
    privacy TEXT,
    unmetNeed INTEGER NOT NULL DEFAULT 0,
    location TEXT,
    emotionValence TEXT NOT NULL DEFAULT 'neutral',
    eventTime TEXT,
    createdAt INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    expiresAt INTEGER NOT NULL DEFAULT 9223372036854775807,
    status TEXT NOT NULL DEFAULT 'active',
    scheduledTime TEXT,
    action TEXT NOT NULL DEFAULT '',
    careType TEXT NOT NULL DEFAULT '',
    topicKey TEXT NOT NULL DEFAULT '',
    sourceActor TEXT NOT NULL DEFAULT '',
    sourceTarget TEXT NOT NULL DEFAULT '',
    lastUsedAt INTEGER NOT NULL DEFAULT 0,
    usedCount INTEGER NOT NULL DEFAULT 0,
    confidence REAL NOT NULL DEFAULT 0.8,
    rawJson TEXT NOT NULL DEFAULT '',
    vectorId TEXT NOT NULL DEFAULT ''
);

CREATE INDEX IF NOT EXISTS memory_items_active_candidates
ON memory_items(ownerType, ownerId, memoryLevel, status, expiresAt, importance DESC, createdAt DESC);

CREATE INDEX IF NOT EXISTS memory_items_backup_created_at
ON memory_items(createdAt DESC, id DESC);

getMemoryItemsByOwner:
SELECT * FROM memory_items WHERE ownerType = ? AND ownerId = ? ORDER BY createdAt DESC;

getAllMemoryItems:
SELECT * FROM memory_items ORDER BY createdAt DESC;

getMemoryItemsByLevel:
SELECT * FROM memory_items WHERE ownerType = ? AND ownerId = ? AND memoryLevel = ? ORDER BY createdAt DESC;

getActiveMemoryItemsMissingVector:
SELECT * FROM memory_items
WHERE status = 'active' AND expiresAt > ? AND content != '' AND vectorId = ''
ORDER BY createdAt ASC
LIMIT ?;

getActiveMemoryItemsByLevel:
SELECT * FROM memory_items
WHERE ownerType = ? AND ownerId = ? AND memoryLevel = ? AND status = 'active' AND expiresAt > ?
ORDER BY importance DESC, createdAt DESC;

getMemoryItemsByType:
SELECT * FROM memory_items WHERE ownerType = ? AND ownerId = ? AND memoryType = ? ORDER BY createdAt DESC;

getMemoryItemById:
SELECT * FROM memory_items WHERE id = ?;

getMemoryIdsBySource:
SELECT id FROM memory_items WHERE sourceKind = ? AND sourceRefId = ?;

getMemoryIdsBySession:
SELECT id FROM memory_items WHERE sessionId = ?;

getMemoryVectorId:
SELECT vectorId FROM memory_items WHERE id = ?;

getMemoryVectorIdsByOwnerAndSourceKind:
SELECT vectorId FROM memory_items
WHERE ownerType = ? AND ownerId = ? AND sourceKind = ? AND vectorId != '';

getMemoryItemsBySource:
SELECT * FROM memory_items WHERE sourceKind = ? AND sourceRefId = ?;

getSourceRefIdsBySourcePrefix:
SELECT DISTINCT sourceRefId FROM memory_items WHERE sourceKind = ? AND sourceRefId LIKE ?;

getActiveMemoryItemByContent:
SELECT * FROM memory_items
WHERE ownerType = ? AND ownerId = ? AND memoryLevel = ? AND memoryType = ? AND content = ? AND status = 'active'
ORDER BY updatedAt DESC LIMIT 1;

getMemoryItemsForBatch:
SELECT * FROM memory_items WHERE ownerType = ? AND ownerId = ? AND memoryLevel = ? AND createdAt BETWEEN ? AND ? ORDER BY createdAt ASC;

insertMemoryItem:
INSERT OR REPLACE INTO memory_items(ownerType, ownerId, memoryLevel, memoryType, sourceKind, sourceRefId, sessionId, content, nickname, importance, privacy, unmetNeed, location, emotionValence, eventTime, createdAt, updatedAt, expiresAt, status, scheduledTime, action, careType, topicKey, sourceActor, sourceTarget, lastUsedAt, usedCount, confidence, rawJson, vectorId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getLastInsertedMemoryItemId:
SELECT last_insert_rowid();

updateMemoryItemVectorId:
UPDATE memory_items SET vectorId = ?, updatedAt = ? WHERE id = ?;

updateMemoryItemContent:
UPDATE memory_items SET content = ?, updatedAt = ? WHERE id = ?;

clearAllMemoryItemVectorIds:
UPDATE memory_items SET vectorId = '';

clearMemoryItemVectorIdsByOwner:
UPDATE memory_items SET vectorId = '' WHERE ownerType = ? AND ownerId = ?;

archiveMemoryItemsByLevel:
UPDATE memory_items SET status = 'archived', updatedAt = ?
WHERE ownerType = ? AND ownerId = ? AND memoryLevel = ? AND status = 'active';

archiveMemoryItem:
UPDATE memory_items SET status = 'archived', updatedAt = ? WHERE id = ?;

markMemoryItemUsed:
UPDATE memory_items SET lastUsedAt = ?, usedCount = usedCount + 1, updatedAt = ? WHERE id = ?;

deleteMemoryItem:
DELETE FROM memory_items WHERE id = ?;

deleteMemoryItemsBySession:
DELETE FROM memory_items WHERE sessionId = ?;

deleteMemoryItemsByOwnerAndSourceKind:
DELETE FROM memory_items WHERE ownerType = ? AND ownerId = ? AND sourceKind = ?;

deleteMemoryItemsBySource:
DELETE FROM memory_items WHERE sourceKind = ? AND sourceRefId = ?;

deleteMemoryItemsBySourcePrefix:
DELETE FROM memory_items WHERE sourceKind = ? AND sourceRefId LIKE ?;

deleteVectorsBySourcePrefix:
DELETE FROM vector_memories
WHERE id IN (
    SELECT vectorId FROM memory_items
    WHERE sourceKind = ? AND sourceRefId LIKE ? AND vectorId != ''
);

deletePrivateRelationshipMemoryItems:
DELETE FROM memory_items WHERE ownerType = ? AND ownerId = ? AND (sourceKind = 'PRIVATE_CHAT' OR (sourceKind = 'MANUAL_MEMORY' AND privacy = 'private'));

deleteMemoryItemsByOwner:
DELETE FROM memory_items WHERE ownerType = ? AND ownerId = ?;

deleteAllMemoryItems:
DELETE FROM memory_items;

deleteExpiredMemoryItems:
UPDATE memory_items SET status = 'expired', updatedAt = ?
WHERE status = 'active' AND expiresAt < ?;
